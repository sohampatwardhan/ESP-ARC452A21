CONFIG_ESP_ARC452A21_HOMEKIT_ENABLE=y
CONFIG_HAP_HTTP_SERVER_PORT=5556
CONFIG_HAP_HTTP_CONTROL_PORT=5557
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_ARC452A21_MATTER_ENABLE=n
